# Copia in .env.local (mai committare i valori reali).

# --- Client (finiscono nel bundle: sono pubbliche per design, protette da RLS) ---
# Se mancano, l'app parte in "modalità locale" (dati solo in questo browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server (solo funzioni /api, MAI nel client) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Facoltativa: senza chiave l'app funziona come archivio + ricerca, senza AI.
GEMINI_API_KEY=
# Facoltativo, default gemini-2.5-flash
GEMINI_MODEL=
